{
  "name": "@aether/sdk",
  "version": "1.0.0",
  "description": "TypeScript SDK and type definitions for Aether extensions",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup && tsc --emitDeclarationOnly",
    "prepare": "npm run build",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "aether",
    "minecraft",
    "launcher",
    "extensions",
    "sdk"
  ],
  "author": "Aether",
  "license": "GPL-3.0-only",
  "type": "commonjs",
  "devDependencies": {
    "tsup": "^8.5.1",
    "typescript": "^7.0.2"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/wayback09/Aether-SDK.git"
  },
  "homepage": "https://github.com/wayback09/Aether-SDK"
}
